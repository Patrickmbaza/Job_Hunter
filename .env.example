APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./data/job_hunter.sqlite3
FRONTEND_ORIGIN=http://localhost:3000
REA_CDP_ENDPOINT=http://127.0.0.1:9224
REA_ALLOWED_ORIGINS=https://example.com
LOW_MEMORY_MODE=true
WORKER_CONCURRENCY=1
# Set a password verifier generated by `cd backend && python -m app.auth_cli`.
# This is a verifier, not the password. Keep the real .env out of version control.
APP_PASSWORD_HASH=
SESSION_TTL_SECONDS=28800
REA_MCP_CONFIG_PATH=~/.codex/config.toml
REA_MCP_SERVER_NAME=rea
REA_STARTUP_TIMEOUT_SECONDS=30
REA_TOOL_TIMEOUT_SECONDS=45
